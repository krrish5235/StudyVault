# ============================================================
# StudyVault environment configuration (copy to .env, never commit)
# Real values come from your secret manager / hosting platform env vars.
# ============================================================

# ---------------- Database (PostgreSQL) ----------------
DATABASE_URL=jdbc:postgresql://localhost:5432/studyvault
DATABASE_USERNAME=studyvault
DATABASE_PASSWORD=change-me-strong

# ---------------- Backend application -------------------
# Comma-separated list of frontend origins allowed by CORS (empty = same-origin only)
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public URL of the frontend, used in emails (verification / reset links)
APP_FRONTEND_URL=http://localhost:3000
# Set cookies Secure flag (MUST be true in production over HTTPS)
APP_COOKIE_SECURE=false
# Optional cookie domain (e.g. .yourdomain.com when API and site share a registrable domain)
APP_COOKIE_DOMAIN=

# ---------------- Storage -------------------------------
# local (development) | s3 (production). Paid files are ALWAYS private.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./data/storage
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---------------- Email ---------------------------------
# log (development: writes emails to log) | smtp (production)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@yourdomain.com

# ---------------- Payments ------------------------------
# razorpay | mock  (mock is for local development only; startup fails in prod profile)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------- First admin bootstrap ------------------
# Create the first ADMIN user at startup when no admin exists yet.
# Leave DISABLED after first run. Password must be >= 12 chars.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com
ADMIN_BOOTSTRAP_PASSWORD=

# ---------------- Frontend ------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
